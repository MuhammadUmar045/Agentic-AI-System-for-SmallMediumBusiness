# Supabase Credentials (replace with your project credentials from supabase.com)
SUPABASE_URL=https://your-project-id.supabase.co
# Use your service_role key (recommended for backend) or anon public key:
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_MINUTES=1440

# OpenAI Configuration (For Agents & pgvector embeddings text-embedding-3-small)
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Meta WhatsApp Cloud API Configuration
WHATSAPP_PHONE_NUMBER_ID=104829104829104
WHATSAPP_ACCESS_TOKEN=your-meta-access-token
WHATSAPP_APP_SECRET=your-meta-app-secret-for-hmac-sha256
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token

# SMTP Email Configuration (Human-in-the-Loop)
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your-smtp-password
SMTP_SENDER_EMAIL=notifications@yourbusiness.pk
SMTP_USE_TLS=true

# CORS
CORS_ORIGINS=http://localhost:5173,https://aicoo-smeo.netlify.app
